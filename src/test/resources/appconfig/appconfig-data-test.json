{
  "empty": {},
  "dev101portalAppConfigApp": {
    "Type": "AWS::AppConfig::Application",
    "Properties": {
      "Name": "dev-101-portal-AppConfigApp"
    }
  },
  "dev101portalAppConfigEnvironment": {
    "Type": "AWS::AppConfig::Environment",
    "Properties": {
      "ApplicationId": {
        "Ref": "dev101portalAppConfigApp"
      },
      "Name": "dev-101-portal-environment"
    }
  },
  "dev101portalAppConfigConfigProfile": {
    "Type": "AWS::AppConfig::ConfigurationProfile",
    "Properties": {
      "ApplicationId": {
        "Ref": "dev101portalAppConfigApp"
      },
      "LocationUri": "hosted",
      "Name": "dev-101-portal-configurations"
    }
  },
  "dev101portalAppConfigHostedConfiguration": {
    "Type": "AWS::AppConfig::HostedConfigurationVersion",
    "Properties": {
      "ApplicationId": { "Ref": "dev101portalAppConfigApp" },
      "ConfigurationProfileId": { "Ref": "dev101portalAppConfigConfigProfile" },
      "Description": "Freeform config for toggling experimental mode features",
      "Content": "{\"GOOGLE_MAP\": null, \"VIEW_ASSOCIATED_PROJECTS\": null, \"PROVENANCE_DOCKER_IMAGES\": null, \"DESCRIPTION_FIELD\": null, \"ADD_WIKI_WIDGETS\": null, \"CUSTOM_STORAGE_LOCATION_SETTINGS\": null, \"CHALLENGE_SUBMISSION_SETTINGS\": null, \"PROVENANCE_V2_VISUALIZATION\": true, \"VIRTUALTABLE_SUPPORT\": null, \"REACT_ENTITY_ACL_EDITOR\": true,\"HOMEPAGE_CHATBOT\": null,\"PORTALS_DROPDOWN\": null,\"UPLOADER_V2\": true, \"SEARCHV2_ENABLED\": true, \"METADATA_TAB\": true, \"CURATOR_LINK_TASK_TO_GRID_SESSION\": true}",
      "ContentType": "application/json"
    }
  },
  "dev101portalAppConfigDeploymentStrategy": {
    "Type": "AWS::AppConfig::DeploymentStrategy",
    "Properties": {
      "Name": "AllAtOnce",
      "DeploymentDurationInMinutes": 0,
      "GrowthFactor": 100,
      "ReplicateTo": "NONE",
      "FinalBakeTimeInMinutes": 0
    }
  },
  "dev101portalAppConfigDeployment": {
    "Type": "AWS::AppConfig::Deployment",
    "Properties": {
      "ApplicationId": {
        "Ref": "dev101portalAppConfigApp"
      },
      "ConfigurationProfileId": {
        "Ref": "dev101portalAppConfigConfigProfile"
      },
      "ConfigurationVersion": {
        "Fn::GetAtt": [
          "dev101portalAppConfigHostedConfiguration",
          "VersionNumber"
        ]
      },
      "DeploymentStrategyId": {
        "Ref": "dev101portalAppConfigDeploymentStrategy"
      },
      "EnvironmentId": {
        "Ref": "dev101portalAppConfigEnvironment"
      }
    }
  }
}
