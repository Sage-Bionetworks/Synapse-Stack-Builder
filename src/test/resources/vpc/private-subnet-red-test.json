                              "PublicUsEast1cNATGatway"
                         ]
                    ]}}
               }
          },
          "RedPrivateUsEast1cRouteTableAssociation": {
               "Type": "AWS::EC2::SubnetRouteTableAssociation",
               "Properties": {
                    "SubnetId": {"Ref": "RedPrivateUsEast1c"},
                    "RouteTableId": {"Ref": "RedPrivateUsEast1cRouteTable"}
               }
          },
          "RedPrivateUsEast1cNetworkAclAssociation": {
               "Type": "AWS::EC2::SubnetNetworkAclAssociation",
               "Properties": {
                    "SubnetId": {"Ref": "RedPrivateUsEast1c"},
                    "NetworkAclId": {"Fn::ImportValue": {"Fn::Join": [
                         "-",
                         [
                              {"Ref": "AWS::Region"},
                              "synapse-dev-vpc-2",
                              "NetworkAclId"
                         ]
                    ]}}
               }
          },
          "VPCEndpoint": {
               "Type": "AWS::EC2::VPCEndpoint",
               "Properties": {
                    "PolicyDocument": {
                         "Version": "2012-10-17",
                         "Statement": [{
                              "Effect": "Allow",
                              "Principal": "*",
                              "Action": ["*"],
                              "Resource": ["*"]
                         }]
                    },
                    "RouteTableIds": [
                         {"Ref": "RedPrivateUsEast1aRouteTable"},
                         {"Ref": "RedPrivateUsEast1bRouteTable"},
                         {"Ref": "RedPrivateUsEast1cRouteTable"}
                    ],
                    "ServiceName": {"Fn::Join": [
                         "",
                         [
                              "com.amazonaws.",
                              {"Ref": "AWS::Region"},
                              ".s3"
                         ]
                    ]},
                    "VpcId": {"Fn::ImportValue": {"Fn::Join": [
                         "-",
                         [
                              {"Ref": "AWS::Region"},
                              "synapse-dev-vpc-2",
                              "VPCId"
                         ]
                    ]}}
               }
          }
     },
     "Outputs": {
          "PrivateSubnets": {
               "Description": "Comma separated list of all private sub-nets",
               "Value": {"Fn::Join": [
                    ", ",
                    [
                         {"Ref": "RedPrivateUsEast1a"},
                         {"Ref": "RedPrivateUsEast1b"},
                         {"Ref": "RedPrivateUsEast1c"}
                    ]
               ]},
               "Export": {"Name": {"Fn::Join": [
                    "-",
                    [
                         {"Ref": "AWS::Region"},
                         {"Ref": "AWS::StackName"},
                         "Private-Subnets"
                    ]
               ]}}
          },
          "PrivateSubnetRouteTableIds": {
               "Description": "Comma separated list of all private sub-net route table IDs",
               "Value": {"Fn::Join": [
                    ", ",
                    [
                         {"Ref": "RedPrivateUsEast1aRouteTable"},
                         {"Ref": "RedPrivateUsEast1bRouteTable"},
                         {"Ref": "RedPrivateUsEast1cRouteTable"}
                    ]
               ]},
               "Export": {"Name": {"Fn::Join": [
                    "-",
                    [
                         {"Ref": "AWS::Region"},
                         {"Ref": "AWS::StackName"},
                         "Private-Subnets-RouteTableIds"
                    ]
               ]}}
          },
          "SubnetGroupCIDR": {
               "Description": "CIDR for this subnetgroup",
               "Value": "10.24.24.0/21",
               "Export": {"Name": {"Fn::Join": [
                    "-",
                    [
                         {"Ref": "AWS::Region"},
                         {"Ref": "AWS::StackName"},
                         "CIDR"
                    ]
               ]}}
          }
     }
}