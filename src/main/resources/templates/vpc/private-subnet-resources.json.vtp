{
	"AWSTemplateFormatVersion": "2010-09-09",
	"Description": "Creates one public subnet per availability zone.",
	"Resources": {

    #set($subnetGroups=$subnets.privateSubnetGroups)
    #set($subnetGroup=$subnetGroups[$privateSubnetIdx])
    #foreach ( $privateSubnet in $subnetGroup.subnets )
        "${privateSubnet.name}": {
            "Type": "AWS::EC2::Subnet",
            "Properties": {
                "MapPublicIpOnLaunch": false,
                "VpcId": { "Fn::ImportValue": { "Fn::Sub": "#[[${AWS::Region}]]#-${vpcStackName}-VPCId" } },
                "CidrBlock": "${privateSubnet.cidr}",
                "AvailabilityZone": "${privateSubnet.availabilityZone}",
            }
        },
        "${privateSubnet.name}RouteTable": {
            "Type": "AWS::EC2::RouteTable",
            "Properties": {
                "VpcId": { "Fn::ImportValue": { "Fn::Sub": "#[[${AWS::Region}]]#-${vpcStackName}-VPCId" } },
            }
        },
        "${privateSubnet.name}PrivateRoute": {
            "Type": "AWS::EC2::Route",
            "Properties": {
                "RouteTableId": {
                    "Ref": "${privateSubnet.name}RouteTable"
                },
                "DestinationCidrBlock": "0.0.0.0/0",
                "NatGatewayId": { "Fn::ImportValue": { "Fn::Sub": "#[[{AWS::Region}]]#-${vpcStackName}-public-subnets-Public${privateSubnet.getAvailabilityZoneRef()}NATGatway" } }
            }
        },
        "${privateSubnet.name}RouteTableAssociation": {
            "Type": "AWS::EC2::SubnetRouteTableAssociation",
            "Properties": {
                "SubnetId": {
                    "Ref": "${privateSubnet.name}"
                },
                "RouteTableId": {
                    "Ref": "${privateSubnet.name}RouteTable"
                }
            }
        },
        "${privateSubnet.name}NetworkAclAssociation": {
            "Type": "AWS::EC2::SubnetNetworkAclAssociation",
            "Properties": {
                "SubnetId": {
                    "Ref": "${privateSubnet.name}"
                },
                "NetworkAclId": {
                    "Fn::ImportValue": { "Fn::Sub": "#[[${AWS::Region}]]#-${vpcStackName}-NetworkAclId" } }
            }
        },
    #end
    "VPCEndpoint":{
      "Type":"AWS::EC2::VPCEndpoint",
      "Properties":{
         "PolicyDocument":{
            "Version":"2012-10-17",
            "Statement":[
               {
                  "Effect":"Allow",
                  "Principal":"*",
                  "Action":[
                     "*"
                  ],
                  "Resource":[
                     "*"
                  ]
               }
            ]
         },
         "RouteTableIds":[
                        #foreach( $privateSubnet in $subnetGroup.subnets )
                        	{"Ref": "${privateSubnet.name}RouteTable"}
                        	#if( $foreach.hasNext),#end
                        #end
                    ],
         "ServiceName": { "Fn::Sub": "com.amazonaws.#[[${AWS::Region}]]#.s3" },
         "VpcId": { "Fn::ImportValue": { "Fn::Sub": "#[[${AWS::Region}]]#-${vpcStackName}-VPCId" } },
      }
    },
    "VPCPrivateLinkSG": {
        "Type": "AWS::EC2::SecurityGroup",
        "Properties": {
          "GroupDescription": "Allow access to AWS Bedrock via PrivateLink",
          "VpcId": { "Fn::ImportValue": { "Fn::Sub": "#[[${AWS::Region}]]#-${vpcStackName}-VPCId" } },
          "SecurityGroupIngress": [{ "IpProtocol": "tcp", "FromPort": 443, "ToPort": 443, "CidrIp": "$vpcCidr" } ]
        }
    },
    #foreach ($vpcEndpointSvc in $vpcEndpointServices)
    #set($capitalizedVpcEndpointSvc = $vpcEndpointSvc.substring(0, 1).toUpperCase() + $vpcEndpointSvc.substring(1))
    #set($sanitizedVpcEndpointSvc = $capitalizedVpcEndpointSvc.replaceAll("-", ""))
    "${sanitizedVpcEndpointSvc}VPCEndpoint": {
        "Type":"AWS::EC2::VPCEndpoint",
        "Properties":{
           "PolicyDocument":{
              "Version":"2012-10-17",
              "Statement":[
                 {
                    "Effect":"Allow",
                    "Principal":"*",
                    "Action":[
                       "*"
                    ],
                    "Resource":[
                       "*"
                    ]
                 }
              ]
           },
           "PrivateDnsEnabled": true,
           "ServiceName": { "Fn::Sub": "com.amazonaws.#[[${AWS::Region}]]#.${vpcEndpointSvc}" },
           "SubnetIds": [
                          #foreach( $privateSubnet in $subnetGroup.subnets )
                            {"Ref": "${privateSubnet.name}"}
                            #if( $foreach.hasNext),#end
                          #end
           ],
           "VpcEndpointType": "interface",
           "VpcId": { "Fn::ImportValue": { "Fn::Sub": "#[[${AWS::Region}]]#-${vpcStackName}-VPCId" } }
        }
    }#if( $foreach.hasNext),#end
    #end
    },
    "Outputs": {
        "PrivateSubnets": {
            "Description": "Comma separated list of all private sub-nets",
            "Value" : {
                "Fn::Join": [
                    ", ",
                    [
                        #foreach( $privateSubnet in $subnetGroup.subnets )
                            {"Ref": "${privateSubnet.name}"}
                            #if( $foreach.hasNext),#end
                        #end
                    ]
                ]
            },
            "Export": { "Name": { "Fn::Sub": "#[[${AWS::Region}-${AWS::StackName}]]#-Private-Subnets" } }
        },
        "PrivateSubnetRouteTableIds": {
            "Description": "Comma separated list of all private sub-net route table IDs",
            "Value" : {
                "Fn::Join": [
                    ", ",
                    [
                        #foreach( $privateSubnet in $subnetGroup.subnets )
                            {"Ref": "${privateSubnet.name}RouteTable"}
                            #if( $foreach.hasNext),#end
                        #end
                    ]
                ]
            },
            "Export": { "Name": { "Fn::Sub": "#[[${AWS::Region}-${AWS::StackName}]]#-Private-Subnets-RouteTableIds" } }
        },
        "SubnetGroupCIDR": {
            "Description": "CIDR for this subnetgroup",
            "Value": "$subnetGroup.cidr",
            "Export": { "Name": { "Fn::Sub": "#[[${AWS::Region}-${AWS::StackName}]]#-CIDR" } }}
        }
    }
}