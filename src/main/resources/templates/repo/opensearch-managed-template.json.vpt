	,
	## In dev the domain is public (no VPCOptions, gated by the IAM AccessPolicies below),
	## so it has no ENIs and this security group would be unused. Only create it for the
	## VPC-attached prod domain.
	#if (${stack} != 'dev')
	"${stack}${instance}SynapseSearchIndexSecurityGroup": {
		"Type": "AWS::EC2::SecurityGroup",
		"Properties": {
			"GroupDescription": "Security group for the per-entity SearchIndex managed OpenSearch domain ENIs in ${stack}${instance}",
			"VpcId": {
				"Fn::ImportValue": "${vpcExportPrefix}-VPCId"
			},
			"SecurityGroupIngress": [
				{
					"Description": "Allow ${subnetGroupColor} subnet HTTPS access from the workers",
					"CidrIp": {
						"Fn::ImportValue": "${vpcExportPrefix}-private-subnets-${subnetGroupColor}-CIDR"
					},
					"FromPort": "443",
					"ToPort": "443",
					"IpProtocol": "tcp"
				}
			],
			"Tags": [
				{
					"Key": "Application",
					"Value": {
						"Ref": "AWS::StackName"
					}
				},
				{
					"Key": "Name",
					"Value": "${stack}${instance}SynapseSearchIndexSecurityGroup"
				}
			]
		}
	},
	#end
	"SynapseSearchIndexDomain": {
		"Type": "AWS::OpenSearchService::Domain",
		"DeletionPolicy": "Delete",
		"Properties": {
			"DomainName": "${stack}-${instance}-synidx",
			"EngineVersion": "OpenSearch_3.7",
			## For prod, openSearchInstanceType / openSearchMasterInstanceType /
			## openSearchAvailabilityZoneCount and the pruned openSearchSubnets list are all injected
			## from RepositoryTemplateBuilderImpl. The AZ count drives ZoneAwarenessConfig here and
			## bounds the subnet list length there.
			"ClusterConfig":
				#if (${stack} == 'prod')
				{
					"InstanceType": "${openSearchInstanceType}.search",
					"InstanceCount": 2,
					"ZoneAwarenessEnabled": true,
					"ZoneAwarenessConfig": { "AvailabilityZoneCount": $openSearchAvailabilityZoneCount },
					"DedicatedMasterEnabled": true,
					"DedicatedMasterType": "${openSearchMasterInstanceType}.search",
					"DedicatedMasterCount": 3
				}
				#else
				{
					"InstanceType": "t3.small.search",
					"InstanceCount": 1,
					"ZoneAwarenessEnabled": false,
					"DedicatedMasterEnabled": false
				}
				#end
			,
			"EBSOptions": {
				"EBSEnabled": true,
				"VolumeType": "gp3",
				"VolumeSize": #if (${stack} == 'prod') 100 #else 20 #end
			},
			"EncryptionAtRestOptions": {
				"Enabled": true
			},
			"NodeToNodeEncryptionOptions": {
				"Enabled": true
			},
			"DomainEndpointOptions": {
				"EnforceHTTPS": true
			},
			## AutoSoftwareUpdateEnabled applies MINOR service software updates automatically
			## during the domain's off-peak maintenance window, using a blue/green deployment
			## (one node at a time, no connectivity loss on a multi-node prod domain). MAJOR
			## engine upgrades (e.g. 3.x -> 4.0) are NOT auto-applied and still require an
			## explicit EngineVersion change.
			"SoftwareUpdateOptions": {
				"AutoSoftwareUpdateEnabled": true
			},
			## Dev omits VPCOptions so the domain gets a public endpoint reachable outside the
			## VPC, gated only by the IAM AccessPolicies below (equivalent to the AOSS dev
			## collection's AllowFromPublic:true). Prod attaches the domain to the private
			## subnets.
			#if (${stack} != 'dev')
			"VPCOptions": {
				"SecurityGroupIds": [
					{ "Ref": "${stack}${instance}SynapseSearchIndexSecurityGroup" }
				],
				"SubnetIds": [
					#foreach($subnetId in $openSearchSubnets)
						"$subnetId"#if($foreach.hasNext),#end
					#end
				]
			},
			#end
			"AccessPolicies": {
				"Version": "2012-10-17",
				"Statement": [
					{
						"Effect": "Allow",
						"Principal": {
							"AWS":
								#if (${stack} == 'dev')
									{"Fn::Sub": "arn:aws:iam::#[[${AWS::AccountId}]]#:root"}
								#else
								[
									#if ($deploymentTarget == "ECS_FARGATE")
										{"Fn::GetAtt": ["${stack}${instance}SynapesRepoWorkersEcsTaskRole", "Arn"]},
									#else
										{"Fn::GetAtt": ["${stack}${instance}SynapesRepoWorkersServiceRole", "Arn"]},
									#end
									{"Fn::GetAtt": ["SynapseSearchIndexMlProxyRole", "Arn"]}
								]
								#end
						},
						"Action": "es:ESHttp*",
						"Resource": {"Fn::Sub": "arn:aws:es:#[[${AWS::Region}]]#:#[[${AWS::AccountId}]]#:domain/${stack}-${instance}-synidx/*"}
					}
				]
			},
			"Tags": [
				{
					"Key": "Application",
					"Value": {
						"Ref": "AWS::StackName"
					}
				},
				{
					"Key": "Name",
					"Value": "${stack}-${instance}-synidx"
				}
			]
		}
	},
	"SynapseSearchIndexBedrockEmbedRole": {
		"Type": "AWS::IAM::Role",
		"Properties": {
			"RoleName": "${stack}-${instance}-synidx-bedrock-embed",
			"AssumeRolePolicyDocument": {
				"Version": "2012-10-17",
				"Statement": [
					{
						"Effect": "Allow",
						"Principal": {
							"Service": "es.amazonaws.com"
						},
						"Action": "sts:AssumeRole",
						"Condition": {
							"StringEquals": {
								"aws:SourceAccount": {
									"Ref": "AWS::AccountId"
								}
							},
							"ArnLike": {
								"aws:SourceArn": {"Fn::Sub": "arn:aws:es:#[[${AWS::Region}:${AWS::AccountId}]]#:domain/${stack}-${instance}-synidx"}
							}
						}
					}
				]
			},
			"Policies": [
				{
					"PolicyName": "${stack}-${instance}-synidx-bedrock-embed-policy",
					"PolicyDocument": {
						"Version": "2012-10-17",
						"Statement": [
							{
								"Effect": "Allow",
								"Action": "bedrock:InvokeModel",
								"Resource": {"Fn::Sub": "arn:aws:bedrock:#[[${AWS::Region}]]#::foundation-model/amazon.titan-embed-text-v2:0"}
							}
						]
					}
				}
			],
			"Tags": [
				{
					"Key": "Application",
					"Value": {
						"Ref": "AWS::StackName"
					}
				},
				{
					"Key": "Name",
					"Value": "${stack}-${instance}-synidx-bedrock-embed"
				}
			]
		}
	},
	## The build host runs outside the stack VPC and cannot reach a VPC-attached domain, so
	## SemanticEmbeddingBuilder sends its ML-Commons calls through this function. It signs with its
	## own role, which holds the iam:PassRole that creating the Bedrock connector requires.
	"SynapseSearchIndexMlProxyRole": {
		"Type": "AWS::IAM::Role",
		"Properties": {
			"RoleName": "${stack}-${instance}-synidx-ml-proxy",
			"AssumeRolePolicyDocument": {
				"Version": "2012-10-17",
				"Statement": [
					{
						"Effect": "Allow",
						"Principal": {
							"Service": "lambda.amazonaws.com"
						},
						"Action": "sts:AssumeRole"
					}
				]
			},
			"ManagedPolicyArns": [
				"arn:aws:iam::aws:policy/service-role/AWSLambdaVPCAccessExecutionRole"
			],
			"Policies": [
				{
					"PolicyName": "${stack}-${instance}-synidx-ml-proxy-policy",
					"PolicyDocument": {
						"Version": "2012-10-17",
						"Statement": [
							{
								"Effect": "Allow",
								"Action": "es:ESHttpPost",
								"Resource": {"Fn::Sub": "arn:aws:es:#[[${AWS::Region}]]#:#[[${AWS::AccountId}]]#:domain/${stack}-${instance}-synidx/*"}
							},
							{
								"Effect": "Allow",
								"Action": "iam:PassRole",
								"Resource": {"Fn::GetAtt": ["SynapseSearchIndexBedrockEmbedRole", "Arn"]}
							}
						]
					}
				}
			],
			"Tags": [
				{
					"Key": "Application",
					"Value": {
						"Ref": "AWS::StackName"
					}
				},
				{
					"Key": "Name",
					"Value": "${stack}-${instance}-synidx-ml-proxy"
				}
			]
		}
	},
	#if (${stack} != 'dev')
	"${stack}${instance}SynapseSearchIndexMlProxySecurityGroup": {
		"Type": "AWS::EC2::SecurityGroup",
		"Properties": {
			"GroupDescription": "Security group for the SearchIndex ML-Commons proxy function in ${stack}${instance}",
			"VpcId": {
				"Fn::ImportValue": "${vpcExportPrefix}-VPCId"
			},
			"Tags": [
				{
					"Key": "Application",
					"Value": {
						"Ref": "AWS::StackName"
					}
				},
				{
					"Key": "Name",
					"Value": "${stack}${instance}SynapseSearchIndexMlProxySecurityGroup"
				}
			]
		}
	},
	#end
	"SynapseSearchIndexMlProxyFunction": {
		"Type": "AWS::Lambda::Function",
		"Properties": {
			"Handler": "index.handler",
			"Role": {"Fn::GetAtt": ["SynapseSearchIndexMlProxyRole", "Arn"]},
			"Runtime": "python3.12",
			"Timeout": 60,
			"Environment": {
				"Variables": {
					"DOMAIN_ENDPOINT": {"Fn::GetAtt": ["SynapseSearchIndexDomain", "DomainEndpoint"]}
				}
			},
			## Prod places the function in the domain's own subnets, whose CIDR the domain security
			## group admits. Dev's domain is public, so the function needs no VPC.
			#if (${stack} != 'dev')
			"VpcConfig": {
				"SecurityGroupIds": [
					{ "Ref": "${stack}${instance}SynapseSearchIndexMlProxySecurityGroup" }
				],
				"SubnetIds": [
					#foreach($subnetId in $openSearchSubnets)
						"$subnetId"#if($foreach.hasNext),#end
					#end
				]
			},
			#end
			"Code": {
				"ZipFile": {
					"Fn::Join": [
						"\n",
						[
							"import os",
							"import urllib.error",
							"import urllib.request",
							"",
							"import boto3",
							"from botocore.auth import SigV4Auth",
							"from botocore.awsrequest import AWSRequest",
							"",
							"def handler(event, context):",
							"    path = event['path']",
							"    if not path.startswith('/_plugins/_ml/'):",
							"        raise ValueError('Path is not an ML-Commons API: ' + path)",
							"    url = 'https://' + os.environ['DOMAIN_ENDPOINT'] + path",
							"    body = event['body'].encode('utf-8')",
							"    signed = AWSRequest(method='POST', url=url, data=body, headers={'Content-Type': 'application/json'})",
							"    SigV4Auth(boto3.Session().get_credentials(), 'es', os.environ['AWS_REGION']).add_auth(signed)",
							"    request = urllib.request.Request(url, data=body, headers=dict(signed.headers), method='POST')",
							"    try:",
							"        with urllib.request.urlopen(request, timeout=50) as response:",
							"            return {'status': response.status, 'body': response.read().decode('utf-8')}",
							"    except urllib.error.HTTPError as e:",
							"        return {'status': e.code, 'body': e.read().decode('utf-8')}"
						]
					]
				}
			},
			"Tags": [
				{
					"Key": "Application",
					"Value": {
						"Ref": "AWS::StackName"
					}
				},
				{
					"Key": "Name",
					"Value": "${stack}-${instance}-synidx-ml-proxy"
				}
			]
		}
	},
	## Owned by the stack so it is deleted with it; otherwise Lambda creates it on first invoke
	## with no retention and it outlives the stack.
	"SynapseSearchIndexMlProxyLogGroup": {
		"Type": "AWS::Logs::LogGroup",
		"Properties": {
			"LogGroupName": {
				"Fn::Sub": "/aws/lambda/#[[${SynapseSearchIndexMlProxyFunction}]]#"
			},
			"RetentionInDays": ${cloudwatchLogRetentionInDays}
		}
	}
