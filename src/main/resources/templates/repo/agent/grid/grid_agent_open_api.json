	"paths": {
		"/repo/v1/grid/json-schema": {
			"get": {
				"tags": [
					"GridAgent"
				],
				"description": "Call to get the JSON schema associated with the grid session  and used for row validation.",
				"operationId": "get_grid_json_schema",
				"parameters": [
				],
				"responses": {
					"200": {
						"description": "The JSON schema used to validate the rows of the grid session.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/org.sagebionetworks.repo.model.schema.JsonSchema"
								}
							}
						}
					}
				}
			}
		},
		"/repo/v1/grid/feature/request": {
			"put": {
				"tags": [
					"GridAgent"
				],
				"description": "Submit a feature request to enhance Grid Agent capabilities for tabular data curation. Agents can specify the desired functionality, category, priority level, use case, and target user role.",
				"operationId": "put_grid_feature_request",
				"parameters": [
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/org.sagebionetworks.repo.model.grid.AgentFeatureRequest"
							}
						}
					},
					"required": true
				},
				"responses": {
					"204": {
						"description": "Void"
					}
				}
			}
		}
	},
	"components": {
		"schemas": {
			"org.sagebionetworks.repo.model.grid.AgentFeatureRequest": {
				"type": "object",
				"properties": {
					"featureDescription": {
						"type": "string",
						"description": "Detailed description of the requested function and how it would help with tabular data curation.",
						"maxLength": 1000,
						"minLength": 10
					},
					"category": {
						"type": "string",
						"description": "Category of the requested feature for better organization and prioritization.",
						"enum": [
							"data_cleaning",
							"data_transformation",
							"data_validation",
							"data_analysis",
							"visualization",
							"import_export",
							"collaboration",
							"automation",
							"other"
						]
					},
					"priority": {
						"type": "string",
						"description": "Suggested priority level for the feature request.",
						"enum": [
							"low",
							"medium",
							"high",
							"critical"
						]
					},
					"useCase": {
						"type": "string",
						"description": "Specific use case or scenario where this feature would be beneficial.",
						"maxLength": 500
					},
					"userRole": {
						"type": "string",
						"description": "Role or type of user who would benefit from this feature (e.g., data analyst, researcher, business user).",
						"maxLength": 100
					}
				},
				"description": "Request for a new function to enhance Agent capabilities for tabular data curation."
			},
