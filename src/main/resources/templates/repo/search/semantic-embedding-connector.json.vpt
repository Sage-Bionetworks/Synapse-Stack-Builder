{
	"name": "${connectorName}",
	"description": "Synapse semantic search embeddings via Amazon Bedrock.",
	"version": 1,
	"protocol": "aws_sigv4",
	"parameters": {
		"region": "${region}",
		"service_name": "bedrock",
		"model": "${foundationModel}",
		"dimensions": ${dimension},
		"normalize": true,
		"embeddingTypes": ["float"]
	},
	"credential": {
		"roleArn": "${bedrockRoleArn}"
	},
	"client_config": {
		"max_retry_times": 4,
		"retry_backoff_policy": "exponential_full_jitter"
	},
	"actions": [
		{
			"action_type": "predict",
			"method": "POST",
			"url": "https://bedrock-runtime.${region}.amazonaws.com/model/${foundationModel}/invoke",
			"headers": {
				"content-type": "application/json",
				"x-amz-content-sha256": "required"
			},
			"request_body": "#[[{ \"inputText\": \"${parameters.inputText}\", \"dimensions\": ${parameters.dimensions}, \"normalize\": ${parameters.normalize}, \"embeddingTypes\": ${parameters.embeddingTypes} }]]#",
			"pre_process_function": "connector.pre_process.bedrock.embedding",
			"post_process_function": "connector.post_process.bedrock.embedding"
		}
	]
}
