
#foreach( $machineType in $machineTypes )
    #foreach( $poolType in $poolTypes )
        ,
        "${stack}${instance}${machineType}Active${poolType}ConnectionPoolExhaustedAlarm": {
            		"Type" : "AWS::CloudWatch::Alarm",
            		"Properties" : {
            			"ActionsEnabled" : true,
            			"AlarmActions" : [
            				{"Fn::ImportValue": "${globalResourcesExportPrefix}-NotificationTopic"}
            			],
            			"AlarmDescription" : "Alert when ${machineType.toLowerCase()} database ${poolType.toLowerCase()} active connection pool is exhausted.",
            			"AlarmName" : "${stack}-${instance}-${machineType}-Active-${poolType}-ConnectionPool-Exhausted",
            			"ComparisonOperator" : "GreaterThanOrEqualToThreshold",
            			"Dimensions" : [
                            {
                                "Name" : "dataSourceId",
                                "Value" : "${poolType.toLowerCase()}"
                            }
                        ],
            			"EvaluationPeriods" : 2,
            			"Period" : 60,
            			"MetricName" : "activeConnectionsCount",
            			"Namespace" : "${machineType}-Database-${instance}",
            			"Statistic" : "Average",
            			"Threshold" : 39,
            			"TreatMissingData": "notBreaching"
            		}
            	}
    #end
#end

#if(${stack} == 'prod')
	,
	"${stack}${instance}DockerRegistryBadCredentialsAlarm": {
		"Type" : "AWS::CloudWatch::Alarm",
		"Properties" : {
			"ActionsEnabled" : true,
			"AlarmActions" : [
				{"Fn::ImportValue": "${globalResourcesExportPrefix}-NotificationTopic"}
			],
			"AlarmDescription" : "Alert when the docker registry authentication filter reports bad credentials.",
			"AlarmName" : "${stack}-${instance}-Docker-Registry-Bad-Credentials",
			"ComparisonOperator" : "GreaterThanOrEqualToThreshold",
			"Dimensions" : [
				{
					"Name" : "filterClass",
					"Value" : "org.sagebionetworks.auth.filter.DockerRegistryAuthFilter"
				}
			],
			"EvaluationPeriods" : 1,
			"Period" : 300,
			"MetricName" : "BadCredentials",
			"Namespace" : "Authentication - ${instance}",
			"Statistic" : "SampleCount",
			"Threshold" : 1,
			"TreatMissingData": "notBreaching"
		}
	},
	"${stack}${instance}CloudMailInBadCredentialsAlarm": {
		"Type" : "AWS::CloudWatch::Alarm",
		"Properties" : {
			"ActionsEnabled" : true,
			"AlarmActions" : [
				{"Fn::ImportValue": "${globalResourcesExportPrefix}-NotificationTopic"}
			],
			"AlarmDescription" : "Alert when the cloud mail in authentication filter reports bad credentials.",
			"AlarmName" : "${stack}-${instance}-Cloud-MailIn-Bad-Credentials",
			"ComparisonOperator" : "GreaterThanOrEqualToThreshold",
			"Dimensions" : [
				{
					"Name" : "filterClass",
					"Value" : "org.sagebionetworks.auth.filter.CloudMailInAuthFilter"
				}
			],
			"EvaluationPeriods" : 1,
			"Period" : 300,
			"MetricName" : "BadCredentials",
			"Namespace" : "Authentication - ${instance}",
			"Statistic" : "SampleCount",
			"Threshold" : 1,
			"TreatMissingData": "notBreaching"
		}
	},
	"${stack}${instance}UnavailableFileHandleAccessedAlarm": {
		"Type" : "AWS::CloudWatch::Alarm",
		"Properties" : {
			"ActionsEnabled" : true,
			"AlarmActions" : [
				{"Fn::ImportValue": "${globalResourcesExportPrefix}-NotificationTopic"}
			],
			"AlarmDescription" : "Alert when a user requests a pre-signed URL for an unavailable file handle.",
			"AlarmName" : "${stack}-${instance}-Unavailable-File-Handle-Accessed",
			"ComparisonOperator" : "GreaterThanOrEqualToThreshold",
			"EvaluationPeriods" : 1,
			"Period" : 300,
			"MetricName" : "UnavailableFileHandleAccessed",
			"Namespace" : "File Handles - ${instance}",
			"Statistic" : "SampleCount",
			"Threshold" : 1,
			"TreatMissingData": "notBreaching"
		}
	},
	"${stack}${instance}SemaphoreLockAutoIncrementHighWaterMarkAlarm": {
		"Type" : "AWS::CloudWatch::Alarm",
		"Properties" : {
			"ActionsEnabled" : true,
			"AlarmActions" : [
				{"Fn::ImportValue": "${globalResourcesExportPrefix}-NotificationTopic"}
			],
			"AlarmDescription" : "Alert when SEMAPHORE_LOCK AUTO_INCREMENT approaches INT max (2,147,483,647). Threshold at 1B gives ~47% headroom.",
			"AlarmName" : "${stack}-${instance}-Semaphore-Lock-AutoIncrement-High-Water-Mark",
			"ComparisonOperator" : "GreaterThanThreshold",
			"Dimensions" : [
				{
					"Name" : "workerClass",
					"Value" : "SemaphoreGarbageCollection"
				}
			],
			"EvaluationPeriods" : 1,
			"Period" : 3600,
			"MetricName" : "SemaphoreLockAutoIncrement",
			"Namespace" : "Asynchronous Workers - ${instance}",
			"Statistic" : "Maximum",
			"Threshold" : 1000000000,
			"TreatMissingData": "notBreaching"
		}
	}
#end