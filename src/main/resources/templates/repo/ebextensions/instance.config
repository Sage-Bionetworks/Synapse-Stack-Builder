{
	"packages":{
		"yum":{
			"mod_ssl": [],
			"mod_security": []
		}
	},
	"files": {
		"/etc/pki/tls/certs/server.crt": {
			"mode": "000400",
			"owner": "root",
			"group": "root",
			"content": ${certificates.jsonEscapedX509CertificatePEM}
		},
		"/etc/pki/tls/certs/server.key": {
			"mode": "000400",
			"owner": "root",
			"group": "root",
			"content": ${certificates.jsonEscapedPrivateKeyPEM}
		},
		"/tmp/update_tomcat_server_xml.sh": {
			"mode": "000400",
			"owner": "root",
			"group": "root",
			"content": ${updateTomcatServerXmlSh}
		}
	},
	"commands": {
		"00_remove_log4j_cve_2026_34480": {
			"test": "rpm -q log4j > /dev/null 2>&1 && rpm -e --test log4j > /dev/null 2>&1",
			"command": "dnf -y remove log4j",
			"ignoreErrors": "true"
		}
	},
	"container_commands": {
		    "00" : { "command" : "sh /tmp/update_tomcat_server_xml.sh" },
	        "01" : { "command" : "chmod +x .platform/hooks/postdeploy/01_restart_services.sh" }
	}
}
