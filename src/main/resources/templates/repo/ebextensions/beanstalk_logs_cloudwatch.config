#### See http://docs.aws.amazon.com/elasticbeanstalk/latest/dg/AWSHowTo.cloudwatchlogs.html
# https://docs.aws.amazon.com/elasticbeanstalk/latest/dg/customize-containers-cw.html
packages:
  yum:
    amazon-cloudwatch-agent: []

files:
  "/opt/aws/amazon-cloudwatch-agent/bin/config.json" :
    mode: "000644"
    owner: root
    group: root
    content: |
      {
        "logs": {
          "logs_collected": {
            "files": {
              "collect_list": [
              #foreach($logDesc in ${logDescriptors})
                {
                  "file_path": "${logDesc.logPath}",
                  "log_group_name": "`{"Fn::Join":["", ["/aws/elasticbeanstalk/", { "Ref":"AWSEBEnvironmentName" }, "/${logDesc.logType}"]]}`",
                  "log_stream_name": "{instance_id}",
                  "retention_in_days": 30,
                  "timestamp_format": "${logDesc.dateFormat}",
                  "multi_line_start_pattern": "{datetime-format}"
                }
              #if($foreach.hasNext),#end
              #end
              ]
            }
          }
        }
      }

container_commands:
  start_cloudwatch_agent: 
    command: /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a append-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/bin/config.json