#### See http://docs.aws.amazon.com/elasticbeanstalk/latest/dg/AWSHowTo.cloudwatchlogs.html
# from https://stackoverflow.com/questions/77390043/how-to-stream-custom-logs-to-cloudwatch-from-al2023-instances
# https://docs.aws.amazon.com/AmazonCloudWatch/latest/monitoring/CloudWatch-Agent-Configuration-File-Details.html#CloudWatch-Agent-Configuration-File-Complete-Example
packages:
  yum:
    amazon-cloudwatch-agent: []

files:
  "/etc/awslogs/awscli.conf" :
    mode: "000600"
    owner: root
    group: root
    content: |
      [plugins]
      cwlogs = cwlogs
      [default]
      region = `{"Ref":"AWS::Region"}`

  "/etc/awslogs/test1.txt" :
    mode: "000600"
    owner: root
    group: root
    content: |
      this is a test
      
  "/etc/awslogs/test2.txt" :
    mode: "000644"
    owner: root
    group: root
    content: |
      this is a test
      
  "/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.d/test2.txt" :
    mode: "000600"
    owner: root
    group: root
    content: |
      this is a test
      
  "/root/test3.txt" :
    mode: "000600"
    owner: root
    group: root
    content: |
      this is a test
      

  "/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json" :
    mode: "000644"
    owner: root
    group: root
    content: |
      {
        "logs": {
          "logs_collected": {
            "files": {
              "collect_list": [
              #foreach($logDesc in ${logDescriptors})
                {
                  "file_path": "${logDesc.logPath}",
                  "log_group_name": "`{"Fn::Join":["", ["/aws/elasticbeanstalk/", { "Ref":"AWSEBEnvironmentName" }, "/${logDesc.logType}"]]}`",
                  "log_stream_name": "{instance_id}",
                  "retention_in_days": 30,
                  "timestamp_format": "${logDesc.dateFormat}",
                  "multi_line_start_pattern": "{datetime-format}"
                }
              #if($foreach.hasNext),#end
              #end
              ]
            }
          }
        }
      }
