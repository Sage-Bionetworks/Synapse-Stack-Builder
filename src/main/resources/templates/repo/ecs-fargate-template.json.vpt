{
	"AWSTemplateFormatVersion": "2010-09-09",
	"Description": "Creates ECS Fargate resources to deploy ${environment.name}",
	"Parameters": {
		#parse("templates/repo/time-to-live-parameter.vpt")
	},
	"Resources": {
		"${environment.refName}ALB": {
			"Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
			"Properties": {
				"Name": "${environment.name}",
				"Scheme": "internal",
				"Type": "application",
				"IpAddressType": "ipv4",
				"SecurityGroups": [
					{
						"Fn::ImportValue": "${sharedExportPrefix}-Load-Balancer-Security-Group-ID"
					}
				],
				"Subnets": [ #foreach($subnet in $ecsSubnetsList)"${subnet}"#if($foreach.hasNext),#end#end ],
				"LoadBalancerAttributes": [
					{
						"Key": "idle_timeout.timeout_seconds",
						"Value": "60"
					},
					{
						"Key": "access_logs.s3.enabled",
						"Value": "true"
					},
					{
						"Key": "access_logs.s3.bucket",
						"Value": "${stack}.alb.access.logs"
					},
					{
						"Key": "access_logs.s3.prefix",
						"Value": "${environment.type}/${stack}/${instance}"
					}
				]
			}
		},
		"${environment.refName}TargetGroup": {
			"Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
			"Properties": {
				"HealthCheckIntervalSeconds": 30,
				"HealthCheckPath": "${environment.healthCheckUrl}",
				"HealthCheckPort": "${environment.containerPort}",
				"HealthCheckProtocol": "HTTPS",
				"HealthCheckTimeoutSeconds": 5,
				"HealthyThresholdCount": 2,
				"UnhealthyThresholdCount": 5,
				"Matcher": {
					"HttpCode": "200,201"
				},
				"Port": ${environment.containerPort},
				"Protocol": "HTTPS",
				"TargetType": "ip",
				"TargetGroupAttributes": [
					{
						"Key": "deregistration_delay.timeout_seconds",
						"Value": "60"
					}
				],
				"VpcId": {
					"Fn::ImportValue": "${vpcExportPrefix}-VPCId"
				}
			}
		},
		"${environment.refName}HttpsListener": {
			"Type": "AWS::ElasticLoadBalancingV2::Listener",
			"Properties": {
				"DefaultActions": [
					{
						"Type": "forward",
						"TargetGroupArn": {
							"Ref": "${environment.refName}TargetGroup"
						}
					}
				],
				"LoadBalancerArn": {
					"Ref": "${environment.refName}ALB"
				},
				"Port": 443,
				"Protocol": "HTTPS",
				"Certificates": [
					{
						"CertificateArn": "${environment.sslCertificateARN}"
					}
				],
				"SslPolicy": "ELBSecurityPolicy-FS-1-2-Res-2020-10"
			}
		},
		"${environment.refName}HttpListener": {
			"Type": "AWS::ElasticLoadBalancingV2::Listener",
			"Properties": {
				"DefaultActions": [
					{
						"Type": "redirect",
						"RedirectConfig": {
							"Protocol": "HTTPS",
							"Port": "443",
							"StatusCode": "HTTP_301"
						}
					}
				],
				"LoadBalancerArn": {
					"Ref": "${environment.refName}ALB"
				},
				"Port": 80,
				"Protocol": "HTTP"
			}
		},
		"${environment.refName}WebACLAssociation": {
			"Type": "AWS::WAFv2::WebACLAssociation",
			"DependsOn": [
				"${environment.refName}ALB",
				"${environment.refName}HttpsListener",
				"${environment.refName}HttpListener",
				"${environment.refName}TargetGroup"
			],
			"Properties": {
				"ResourceArn": {
					"Ref": "${environment.refName}ALB"
				},
				"WebACLArn": {
					"Fn::ImportValue": "${sharedExportPrefix}-Web-ACL-ARN"
				}
			}
		},
		"${environment.refName}LogGroup": {
			"Type": "AWS::Logs::LogGroup",
			"Properties": {
				"LogGroupName": "/ecs/${environment.name}/application",
				"RetentionInDays": 14
			}
		},
		"${environment.refName}TaskExecutionRole": {
			"Type": "AWS::IAM::Role",
			"Properties": {
				"RoleName": "${environment.name}-ecs-execution-role",
				"AssumeRolePolicyDocument": {
					"Version": "2012-10-17",
					"Statement": [
						{
							"Effect": "Allow",
							"Principal": {
								"Service": "ecs-tasks.amazonaws.com"
							},
							"Action": "sts:AssumeRole"
						}
					]
				},
				"ManagedPolicyArns": [
					"arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
				]
			}
		},
		"${environment.refName}TaskRole": {
			"Type": "AWS::IAM::Role",
			"Properties": {
				"RoleName": "${environment.name}-ecs-task-role",
				"AssumeRolePolicyDocument": {
					"Version": "2012-10-17",
					"Statement": [
						{
							"Effect": "Allow",
							"Principal": {
								"Service": "ecs-tasks.amazonaws.com"
							},
							"Action": "sts:AssumeRole"
						}
					]
				},
				"ManagedPolicyArns": [
					{
						"Fn::ImportValue": "${sharedExportPrefix}-${environment.instanceProfileSuffix}-Managed-Policy-ARN"
					}
				]
			}
		},
		"${environment.refName}TaskDefinition": {
			"Type": "AWS::ECS::TaskDefinition",
			"Properties": {
				"Family": "${environment.name}",
				"Cpu": "${environment.cpu}",
				"Memory": "${environment.memory}",
				"NetworkMode": "awsvpc",
				"RequiresCompatibilities": ["FARGATE"],
				"ExecutionRoleArn": {
					"Fn::GetAtt": ["${environment.refName}TaskExecutionRole", "Arn"]
				},
				"TaskRoleArn": {
					"Fn::GetAtt": ["${environment.refName}TaskRole", "Arn"]
				},
				"ContainerDefinitions": [
					{
						"Name": "${environment.name}",
						"Image": "${environment.dockerImageUri}",
						"Essential": true,
						"HealthCheck": {
							"Command": ["CMD-SHELL", "curl -fk https://localhost:${environment.containerPort}${environment.healthCheckUrl} || exit 1"],
							"Interval": 30,
							"Timeout": 5,
							"Retries": 3,
							"StartPeriod": 600
						},
						"PortMappings": [
							{
								"ContainerPort": ${environment.containerPort},
								"Protocol": "tcp"
							}
						],
						"LogConfiguration": {
							"LogDriver": "awslogs",
							"Options": {
								"awslogs-group": {
									"Ref": "${environment.refName}LogGroup"
								},
								"awslogs-region": "us-east-1",
								"awslogs-stream-prefix": "ecs"
							}
						},
						"Environment": [
							{
								"Name": "org.sagebionetworks.stack",
								"Value": "${stack}"
							},
							{
								"Name": "org.sagebionetworks.stack.instance",
								"Value": "${instance}"
							},
							{
								"Name": "org.sagebionetworks.stack.repo.beanstalk.number",
								"Value": "${repoBeanstalkNumber}"
							}
							#if ($environment.isTypeRepositoryOrWorkers())
							,
							{
								"Name": "org.sagebionetworks.stack.cmk.alias",
								"Value": "${stackCMKAlias}"
							},
							{
								"Name": "org.sagebionetworks.fileservice.endpoint",
								"Value": "https://repo-${stack}-${instance}-${repoBeanstalkNumber}.${stack}.sagebase.org/file/v1"
							},
							{
								"Name": "org.sagebionetworks.authenticationservice.publicendpoint",
								"Value": "https://repo-${stack}-${instance}-${repoBeanstalkNumber}.${stack}.sagebase.org/auth/v1"
							},
							{
								"Name": "org.sagebionetworks.authenticationservice.privateendpoint",
								"Value": "https://repo-${stack}-${instance}-${repoBeanstalkNumber}.${stack}.sagebase.org/auth/v1"
							},
							{
								"Name": "org.sagebionetworks.repositoryservice.endpoint",
								"Value": "https://repo-${stack}-${instance}-${repoBeanstalkNumber}.${stack}.sagebase.org/repo/v1"
							},
							{
								"Name": "org.sagebionetworks.notification.email.address",
								"Value": "notifications@synapse.org"
							},
							{
								"Name": "org.sagebionetworks.search.enabled",
								"Value": "true"
							},
							{
								"Name": "org.sagebionetworks.id.generator.database.username",
								"Value": "${stack}idgenuser"
							},
							{
								"Name": "org.sagebionetworks.id.generator.database.connection.url",
								"Value": "jdbc:mysql://${stack}-id-generator-db.${stack}.sagebase.org/${stack}idgen"
							},
							{
								"Name": "org.sagebionetworks.repository.database.username",
								"Value": "${stack}${instance}user"
							},
							{
								"Name": "org.sagebionetworks.repository.db.readonlyusername",
								"Value": "${stack}${instance}ro"
							},
							{
								"Name": "org.sagebionetworks.repository.database.connection.url",
								"Value": "jdbc:mysql://${stack}-${instance}-db.${dbEndpointSuffix}/${stack}${instance}?verifyServerCertificate=false&useSSL=true&requireSSL=true"
							},
							{
								"Name": "org.sagebionetworks.table.cluster.use.ssl",
								"Value": "true"
							},
							{
								"Name": "org.sagebionetworks.table.cluster.schema.0",
								"Value": "${stack}${instance}"
							},
							{
								"Name": "org.sagebionetworks.table.cluster.endpoint.0",
								"Value": "${stack}-${instance}-table-0.${dbEndpointSuffix}"
							},
							{
								"Name": "org.sagebionetworks.table.cluster.database.count",
								"Value": "1"
							},
							{
								"Name": "org.sagebionetworks.s3.bucket",
								"Value": "${stack}data.sagebase.org"
							},
							{
								"Name": "org.sagebionetworks.ezid.username",
								"Value": "sagebio"
							},
							{
								"Name": "org.sagebionetworks.ezid.doi.prefix",
								"Value": "doi:10.7303/"
							},
							{
								"Name": "org.sagebionetworks.doi.prefix",
								"Value": "10.7303"
							},
							{
								"Name": "org.sagebionetworks.hmac.signing.key.current.version",
								"Value": "1"
							},
							{
								"Name": "org.sagebionetworks.secrets.key",
								"Value": "${environment.secretsSource.key}"
							},
							{
								"Name": "org.sagebionetworks.secrets.bucket",
								"Value": "${environment.secretsSource.bucket}"
							},
							{
								"Name": "org.sagebionetworks.oauth.authorization.endpoint",
								"Value": "${oauthEndpoint}"
							},
							{
								"Name": "org.sagebionetworks.sts.iam.arn",
								"Value": {"Fn::ImportValue": "${sharedExportPrefix}-Temp-Credentials-Service-Role-Arn"}
							},
							{
								"Name": "org.sagebionetworks.cloudfront.keypair",
								"Value": "${dataCdnKeyPairId}"
							},
							{
								"Name": "org.sagebionetworks.cloudfront.domainname",
								"Value": "${dataCdnDomainName}"
							},
							{
								"Name": "org.sagebionetworks.oauth2.sagebio.discoveryDocument",
								"Value": "${DiscoveryDocumentUrl}"
							}
							#end
						]
					}
				]
			}
		},
		"${environment.refName}Service": {
			"Type": "AWS::ECS::Service",
			"DependsOn": [
				"${environment.refName}HttpsListener",
				"${environment.refName}HttpListener"
			],
			"Properties": {
				"ServiceName": "${environment.name}",
				"Cluster": {
					"Fn::ImportValue": "${sharedExportPrefix}-ECS-Cluster-ARN"
				},
				"TaskDefinition": {
					"Ref": "${environment.refName}TaskDefinition"
				},
				"DesiredCount": ${environment.minTasks},
				"LaunchType": "FARGATE",
				"DeploymentConfiguration": {
					"MaximumPercent": 200,
					"MinimumHealthyPercent": 100,
					"DeploymentCircuitBreaker": {
						"Enable": true,
						"Rollback": true
					}
				},
				"NetworkConfiguration": {
					"AwsvpcConfiguration": {
						"AssignPublicIp": "DISABLED",
						"SecurityGroups": [
							{
								"Fn::ImportValue": "${sharedExportPrefix}-ECS-Task-Security-Group-ID"
							}
						],
						"Subnets": [ #foreach($subnet in $ecsSubnetsList)"${subnet}"#if($foreach.hasNext),#end#end ]
					}
				},
				"LoadBalancers": [
					{
						"ContainerName": "${environment.name}",
						"ContainerPort": ${environment.containerPort},
						"TargetGroupArn": {
							"Ref": "${environment.refName}TargetGroup"
						}
					}
				],
				"HealthCheckGracePeriodSeconds": 600
			}
		},
		"${environment.refName}ScalableTarget": {
			"Type": "AWS::ApplicationAutoScaling::ScalableTarget",
			"Properties": {
				"MaxCapacity": ${environment.maxTasks},
				"MinCapacity": ${environment.minTasks},
				"ResourceId": {
					"Fn::Join": [
						"/",
						[
							"service",
							{
								"Fn::ImportValue": "${sharedExportPrefix}-ECS-Cluster-Name"
							},
							"${environment.name}"
						]
					]
				},
				"RoleARN": {
					"Fn::Sub": "arn:aws:iam::${!AWS::AccountId}:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService"
				},
				"ScalableDimension": "ecs:service:DesiredCount",
				"ServiceNamespace": "ecs"
			},
			"DependsOn": ["${environment.refName}Service"]
		},
		"${environment.refName}ScalingPolicy": {
			"Type": "AWS::ApplicationAutoScaling::ScalingPolicy",
			"Properties": {
				"PolicyName": "${environment.name}-cpu-scaling",
				"PolicyType": "TargetTrackingScaling",
				"ScalingTargetId": {
					"Ref": "${environment.refName}ScalableTarget"
				},
				"TargetTrackingScalingPolicyConfiguration": {
					"PredefinedMetricSpecification": {
						"PredefinedMetricType": "ECSServiceAverageCPUUtilization"
					},
					"TargetValue": 70.0,
					"ScaleInCooldown": 360,
					"ScaleOutCooldown": 60
				}
			}
		},
		"${environment.refName}CNAME": {
			"Type": "AWS::Route53::RecordSet",
			"Properties": {
				"HostedZoneName": "${environment.hostedZone}.",
				"Name": "${environment.name}.${environment.hostedZone}.",
				"Type": "A",
				"AliasTarget": {
					"DNSName": {
						"Fn::GetAtt": ["${environment.refName}ALB", "DNSName"]
					},
					"HostedZoneId": {
						"Fn::GetAtt": ["${environment.refName}ALB", "CanonicalHostedZoneID"]
					}
				}
			}
		}
		#foreach($alarm in $loadBalancerAlarms)
		,
		"${environment.refName}${alarm.name.replaceAll('-','')}": {
			"Type": "AWS::CloudWatch::Alarm",
			"Properties": {
				"AlarmName": "${environment.name}-AWS-ELB-${alarm.name}",
				"AlarmDescription": "${alarm.description}",
				"AlarmActions": [
					{
						"Fn::ImportValue": "${globalResourcesExportPrefix}-NotificationTopic"
					}
				],
				"Namespace": "AWS/ApplicationELB",
				"MetricName": "${alarm.metric}",
				"Statistic": "${alarm.statistic}",
				"Period": ${alarm.period},
				"EvaluationPeriods": ${alarm.evaluationPeriods},
				"Threshold": ${alarm.threshold},
				"ComparisonOperator": "${alarm.comparisonOperator}",
				"Dimensions": [
					{
						"Name": "LoadBalancer",
						"Value": {
							"Fn::GetAtt": ["${environment.refName}ALB", "LoadBalancerFullName"]
						}
					}
				]
			}
		}
		#end
	},
	"Outputs": {
		"${environment.refName}AlbArn": {
			"Description": "ARN of the ALB for ${environment.name}",
			"Value": {
				"Ref": "${environment.refName}ALB"
			},
			"Export": {
				"Name": {
					"Fn::Join": [
						"-",
						[
							{
								"Ref": "AWS::Region"
							},
							"${targetGroup.fullName}-alb-arn"
						]
					]
				}
			}
		},
		"URL": {
			"Description": "URL of the ECS Service",
			"Value": {
				"Fn::GetAtt": ["${environment.refName}ALB", "DNSName"]
			},
			"Export": {
				"Name": {
					"Fn::Join": [
						"-",
						[
							{
								"Ref": "AWS::Region"
							},
							{
								"Ref": "AWS::StackName"
							},
							"EndpointURL"
						]
					]
				}
			}
		},
		#parse("templates/repo/time-to-live-out.vpt")
	}
}
