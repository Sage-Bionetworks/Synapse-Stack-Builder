{
	"AWSTemplateFormatVersion": "2010-09-09",
	"Description": "This template sets up a WebSocket API using Amazon API Gateway and integrates it with custom HTTP endpoints for $connect, $disconnect, and $default routes.",
	"Resources": {
		"WebSocketApi": {
			"Type": "AWS::ApiGatewayV2::Api",
			"DeletionPolicy": "Delete",
			"Properties": {
				"IpAddressType": "ipv4",
				"Name": "grid-ws-test",
				"ProtocolType": "WEBSOCKET",
				"RouteSelectionExpression": "$request.body.action"
			}
		},
		"ConnectRoute": {
			"Type": "AWS::ApiGatewayV2::Route",
			"DeletionPolicy": "Delete",
			"Properties": {
				"ApiId": {
					"Ref": "WebSocketApi"
				},
				"RouteKey": "$connect",
				"AuthorizationType": " NONE",
				"ApiKeyRequired": false,
				"Target": {
					"Fn::Join": [
						"/",
						[
							"integrations",
							{
								"Ref": "ConnectIntegration"
							}
						]
					]
				}
			}
		},
		"DisconnectRoute": {
			"Type": "AWS::ApiGatewayV2::Route",
			"DeletionPolicy": "Delete",
			"Properties": {
				"ApiId": {
					"Ref": "WebSocketApi"
				},
				"RouteKey": "$disconnect",
				"RouteResponseSelectionExpression": "$default",
				"Target": {
					"Fn::Join": [
						"/",
						[
							"integrations",
							{
								"Ref": "DisconnectIntegration"
							}
						]
					]
				}
			}
		},
		"DefaultRoute": {
			"Type": "AWS::ApiGatewayV2::Route",
			"DeletionPolicy": "Delete",
			"Properties": {
				"ApiId": {
					"Ref": "WebSocketApi"
				},
				"RouteKey": "$default",
				"RouteResponseSelectionExpression": "$default",
				"Target": {
					"Fn::Join": [
						"/",
						[
							"integrations",
							{
								"Ref": "DefaultIntegration"
							}
						]
					]
				}
			}
		},
		"DefaultRoutResponse": {
			"Type": "AWS::ApiGatewayV2::RouteResponse",
			"Properties": {
				"RouteId": {
					"Ref": "DefaultRoute"
				},
				"ApiId": {
					"Ref": "WebSocketApi"
				},
				"RouteResponseKey": "$default"
			}
		},
		"ConnectIntegration": {
			"Type": "AWS::ApiGatewayV2::Integration",
			"DeletionPolicy": "Delete",
			"Properties": {
				"ApiId": {
					"Ref": "WebSocketApi"
				},
				"IntegrationType": "HTTP_PROXY",
				"IntegrationUri": "https://repo-dev-jmhill-0.dev.sagebase.org/repo/v1/gridws/connect",
				"IntegrationMethod": "POST",
				"RequestParameters": {
					"integration.request.header.wsconnectionid": "context.connectionId"
				}
			}
		},
		"DisconnectIntegration": {
			"Type": "AWS::ApiGatewayV2::Integration",
			"DeletionPolicy": "Delete",
			"Properties": {
				"ApiId": {
					"Ref": "WebSocketApi"
				},
				"IntegrationType": "HTTP_PROXY",
				"IntegrationUri": "https://repo-dev-jmhill-0.dev.sagebase.org/repo/v1/gridws/disconnect",
				"IntegrationMethod": "POST",
				"RequestParameters": {
					"integration.request.header.wsconnectionid": "context.connectionId"
				}
			}
		},
		"DefaultIntegration": {
			"Type": "AWS::ApiGatewayV2::Integration",
			"DeletionPolicy": "Delete",
			"Properties": {
				"ApiId": {
					"Ref": "WebSocketApi"
				},
				"IntegrationType": "HTTP_PROXY",
				"IntegrationUri": "https://repo-dev-jmhill-0.dev.sagebase.org/repo/v1/gridws/default",
				"IntegrationMethod": "POST",
				"RequestParameters": {
					"integration.request.header.wsconnectionid": "context.connectionId"
				}
			}
		},
		"ApiDeployment": {
			"Type": "AWS::ApiGatewayV2::Deployment",
			"DeletionPolicy": "Delete",
			"Properties": {
				"ApiId": {
					"Ref": "WebSocketApi"
				}
			},
			"DependsOn": [
				"ConnectRoute",
				"DisconnectRoute",
				"DefaultRoute"
			]
		},
		"Stage": {
			"Type": "AWS::ApiGatewayV2::Stage",
			"Properties": {
				"ApiId": {
					"Ref": "WebSocketApi"
				},
				"DeploymentId": {
					"Ref": "ApiDeployment"
				},
				"StageName": "dev"
			}
		}
	},
	"Outputs": {
		"WebSocketApiId": {
			"Description": "The ID of the WebSocket API.",
			"Value": {
				"Ref": "WebSocketApi"
			}
		}
	}
}
