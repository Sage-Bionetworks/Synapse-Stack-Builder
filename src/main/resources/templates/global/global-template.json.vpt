{
	"AWSTemplateFormatVersion": "2010-09-09",
	"Description": "Creates global resources for the Synapse stacks.",
	"Resources": {
#parse("templates/global/sns-template.json.vpt")
#parse("templates/global/webacl-cloudwatch-loggroup.json.vpt")
#parse("templates/global/bedrock-kb-template.json.vpt")
#parse("templates/global/rds-snapshot-encryption-key.json.vpt")
#parse("templates/global/cognito-user-pool.json.vpt")
	},
	"Outputs": {
		"NotificationTopic": {
			"Description": "Notification topic for the ${stack} stack",
			"Value": { "Ref":"${stack}NotificationTopic"},
			"Export": {
				"Name": {
					"Fn::Join": [
						"-",
						[
							{
								"Ref": "AWS::Region"
							},
							{
								"Ref": "AWS::StackName"
							},
							"NotificationTopic"
						]
					]
				}
			}
		},
		"SesSynapseOrgBounceTopic": {
			"Description": "Topic for SES bounces from synapse.org for the ${stack} stack",
			"Value": { "Ref":"SesSynapseOrgBounceTopic"},
			"Export": {
				"Name": {
					"Fn::Join": [
						"-",
						[
							{
								"Ref": "AWS::Region"
							},
							{
								"Ref": "AWS::StackName"
							},
							"SesSynapseOrgBounceTopic"
						]
					]
				}
			}
		},
		"SesSynapseOrgComplaintTopic": {
			"Description": "Topic for SES complaints from synapse.org for the ${stack} stack",
			"Value": { "Ref":"SesSynapseOrgComplaintTopic"},
			"Export": {
				"Name": {
					"Fn::Join": [
						"-",
						[
							{
								"Ref": "AWS::Region"
							},
							{
								"Ref": "AWS::StackName"
							},
							"SesSynapseOrgComplaintTopic"
						]
					]
				}
			}
		},
		"WebAclCloudwatchLogGroupArn": {
		    "Description": "Cloudwatch log group for the stack WebACL",
		    "Value": { "Fn::GetAtt": ["${stack}WebAclLogGroup", "Arn"] },
		    "Export": {
		        "Name": {
					"Fn::Join": [
						"-",
						[
							{
								"Ref": "AWS::Region"
							},
							{
								"Ref": "AWS::StackName"
							},
							"WebAclCloudWatchLogGroupArn"
						]
					]
		        }
		    }
		},
		"SynapseHelpKnowledgeBaseId": {
			"Description": "The id of the shared bedrock KB that contains the synapse help documentation",
			"Value": {"Fn::GetAtt": ["SynapseHelpKnowledgeBase", "KnowledgeBaseId"]},
			"Export": {
		        "Name": {
					"Fn::Join": [
						"-",
						[
							{
								"Ref": "AWS::Region"
							},
							{
								"Ref": "AWS::StackName"
							},
							"SynapseHelpKnowledgeBaseId"
						]
					]
		        }
		    }
		},
		"SynapseHelpKnowledgeBaseArn": {
			"Description": "The arn of the shared bedrock KB that contains the synapse help documentation",
			"Value": {"Fn::GetAtt": ["SynapseHelpKnowledgeBase", "KnowledgeBaseArn"]},
			"Export": {
		        "Name": {
					"Fn::Join": [
						"-",
						[
							{
								"Ref": "AWS::Region"
							},
							{
								"Ref": "AWS::StackName"
							},
							"SynapseHelpKnowledgeBaseArn"
						]
					]
		        }
		    }
		},
		"CognitoUserPoolId": {
            "Description": "Id of the shared Cognito user pool for this stack/instance.",
            "Value": { "Ref": "${stack}CognitoUserPool" },
            "Export": {
                "Name": "${CognitoUserPoolId}"
            }
        },
        "CognitoUserPoolClientId": {
            "Description": "App client id for the shared Cognito user pool for this stack/instance.",
            "Value": { "Ref": "${stack}CognitoUserPoolClient" },
            "Export": {
                "Name": "${CognitoUserPoolClientId}"
            }
        }
	}
}